# Copier ce fichier en .env et renseigner la clé Resend (jamais de préfixe VITE_ : la clé doit rester côté serveur)
RESEND_API_KEY=

# Suivi Google (facultatif, voir src/lib/googleTag.ts). À renseigner aussi dans Vercel (Settings > Environment Variables) puis redéployer.
# Sans VITE_GA4_ID ni VITE_GOOGLE_ADS_ID : aucun tag Google ni bandeau cookies.
VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LABEL_BOOKING=
VITE_GOOGLE_ADS_LABEL_FORM=
VITE_GOOGLE_ADS_LABEL_PHONE=
